-- ===== HELPERS =====
local function formatTime(seconds)
    local h = math.floor(seconds / 3600)
    local m = math.floor((seconds % 3600) / 60)
    local s = seconds % 60
    return string.format("%02d:%02d:%02d", h, m, s)
end

local function voltClick(x, y)
    mousemoveabs(x, y)
    task.wait(0.02)
    mouse1press()
    task.wait(0.02)
    mouse1release()
end

local function runClickStage(label, waitBefore, coords, perClickDelay)
    print("\n[STAGE]", label)
    task.wait(waitBefore)
    for _, c in ipairs(coords) do
        local x, y = c[1], c[2]
        print("Click:", label, "→ X=" .. x .. " Y=" .. y)
        voltClick(x, y)
        task.wait(perClickDelay)
    end
end

