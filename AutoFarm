if not game:IsLoaded() then game.Loaded:Wait() end

local TeleportService = game:GetService("TeleportService")

-- ===== GLOBAL STATE =====
_G.relogCount = _G.relogCount or 0
_G.moneyEarned = _G.moneyEarned or 0
_G.startTime = _G.startTime or os.time()

-- ===== STARTUP MESSAGE =====
print("CLICK INTO THE GAME WINDOW — FARM STARTS IN 5 SECONDS")
task.wait(5)

-- ===== CLICK FUNCTION =====
local function voltClick(x, y)
    mousemoveabs(x, y)
    task.wait(0.02)
    mouse1press()
    task.wait(0.02)
    mouse1release()
end

-- ===== MAIN FARM FUNCTION =====
local function runFarm()
    print("\n[HAVOC FARM] Cycle start")

    --------------------------------------------------------------------
    -- Skip to Main Menu
    task.wait(0.5)
    voltClick(968, 597)
    task.wait(0.15)

    --------------------------------------------------------------------
    -- Main Menu → Traders
    task.wait(0.5)
    voltClick(866, 1062)
    task.wait(0.15)

    --------------------------------------------------------------------
    -- Click Trader (Dragov)
    task.wait(0.5)
    voltClick(646, 452)
    task.wait(0.15)
    voltClick(646, 452)
    task.wait(0.15)

    --------------------------------------------------------------------
    -- Dialogue Choice
    task.wait(0.4)
    voltClick(662, 852)
    task.wait(0.15)

    --------------------------------------------------------------------
    -- Back to Inventory
    task.wait(0.7)
    voltClick(159, 86)
    task.wait(0.15)

    --------------------------------------------------------------------
    -- Open Sell Menu
    task.wait(0.5)
    voltClick(1293, 164)
    task.wait(0.15)

    --------------------------------------------------------------------
    -- Click All 17 Sellable Items
    local items = {
        {1293,164}, {986,186}, {924,185}, {860,189},
        {808,182}, {805,244}, {882,251}, {655,412},
        {243,418}, {245,268}, {652,279}, {224,535},
        {344,682}, {274,793}, {585,796}, {652,537},
        {634,665},
    }

    task.wait(0.02)
    for _, pos in ipairs(items) do
        voltClick(pos[1], pos[2])
        task.wait(0.08)
    end

    --------------------------------------------------------------------
    -- Final Sell Confirm
    task.wait(0.5)
    voltClick(1185, 884)
    task.wait(0.2)

    --------------------------------------------------------------------
    -- Counters
    _G.relogCount = (_G.relogCount % 100) + 1
    _G.moneyEarned = _G.moneyEarned + 7446

    local runtime = os.time() - _G.startTime

    print("\n[HAVOC FARM STATUS]")
    print("Relogs:", _G.relogCount, "/ 100")
    print("Money Earned:", _G.moneyEarned)
    print("Runtime:", string.format("%02d:%02d:%02d",
        math.floor(runtime/3600),
        math.floor((runtime%3600)/60),
        runtime%60
    ))
    print("------------------------------------")

    --------------------------------------------------------------------
    -- Teleport (rejoin)
    TeleportService:Teleport(game.PlaceId)
end

-- ===== AUTO‑RESTART LOOP =====
while true do
    runFarm()
    task.wait(10) -- wait for teleport + reload
end
