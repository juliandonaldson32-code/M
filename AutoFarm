if not game:IsLoaded() then game.Loaded:Wait() end

local Players = game:GetService("Players")
local LocalPlayer = Players.LocalPlayer
local PlayerGui = LocalPlayer:WaitForChild("PlayerGui")
local TeleportService = game:GetService("TeleportService")
local VirtualInputManager = game:GetService("VirtualInputManager")
local UserInputService = game:GetService("UserInputService")
local Workspace = game:GetService("Workspace")

-- ===== queue_on_teleport (AUTO-RESTART) =====
local queueteleport = queue_on_teleport or (syn and syn.queue_on_teleport) or (fluxus and fluxus.queue_on_teleport)

Players.LocalPlayer.OnTeleport:Connect(function()
    if queueteleport then
        queueteleport("loadstring(game:HttpGet('https://raw.githubusercontent.com/juliandonaldson32-code/M/main/AutoFarm'))()")
    end
end)

-- ===== GLOBAL STATE =====
_G.relogCount = _G.relogCount or 0
_G.moneyEarned = _G.moneyEarned or 0
_G.startTime = _G.startTime or os.time()

-- ===== STARTUP WARNING =====
print("CLICK INTO THE GAME WINDOW — FARM STARTS IN 5 SECONDS")
task.wait(5)

-- ===== OFFSET (fixes high-click issue) =====
local CLICK_OFFSET_Y = 50

-- ===== UI CLICKER =====
local function clickObject(obj)
    if not obj or not obj:IsA("GuiObject") then return end

    local x = obj.AbsolutePosition.X + obj.AbsoluteSize.X/2
    local y = obj.AbsolutePosition.Y + obj.AbsoluteSize.Y/2 + CLICK_OFFSET_Y

    VirtualInputManager:SendMouseMoveEvent(x, y, game, 0)
    task.wait(0.05)
    VirtualInputManager:SendMouseButtonEvent(x, y, 0, true, game, 0)
    task.wait(0.05)
    VirtualInputManager:SendMouseButtonEvent(x, y, 0, false, game, 0)
end

local function clickCenter()
    local v = Workspace.CurrentCamera.ViewportSize
    local x = v.X/2
    local y = v.Y/2 + CLICK_OFFSET_Y

    VirtualInputManager:SendMouseMoveEvent(x, y, game, 0)
    task.wait(0.05)
    VirtualInputManager:SendMouseButtonEvent(x, y, 0, true, game, 0)
    task.wait(0.05)
    VirtualInputManager:SendMouseButtonEvent(x, y, 0, false, game, 0)
end

-- ===== WAIT FOR MAIN MENU =====
local function waitForMainMenu()
    while true do
        clickCenter()
        task.wait(0.1)

        local ui = PlayerGui:FindFirstChild("UI")
        if ui then
            local mm = ui:FindFirstChild("mainMenuFrame")
            if mm and mm:FindFirstChild("lobbyBottom") and mm.lobbyBottom.Visible then
                return mm.lobbyBottom
            end
        end
    end
end

-- ===== SELL ALL ITEMS =====
local function sellAll()
    local ui = PlayerGui:FindFirstChild("UI")
    if not ui then return end

    local hud = ui:FindFirstChild("HUD")
    if not hud then return end

    local backpack = hud:FindFirstChild("backpackFrame")
    if not backpack then return end

    local trader = backpack:FindFirstChild("traderCenterFrame") or backpack:FindFirstChild("trader")
    if not trader then return end

    local sellSwitch = trader:FindFirstChild("traderSellButton")
    local dealButton = trader:FindFirstChild("dealButtonFrame") and trader.dealButtonFrame:FindFirstChild("dealButton")

    if sellSwitch then clickObject(sellSwitch) end
    task.wait(0.25)

    local playerContainer = backpack:FindFirstChild("player")
    if not playerContainer then return end

    local pocket
    for _, child in ipairs(playerContainer:GetChildren()) do
        if child:IsA("Frame") and child.Name == "inventoryFrame" then
            pocket = child
            break
        end
    end

    if not pocket then return end

    local items = pocket:FindFirstChild("items") or pocket
    for _, itemFrame in ipairs(items:GetChildren()) do
        if itemFrame:IsA("Frame") then
            local button = itemFrame:FindFirstChild("button")
            if button then clickObject(button) end
            task.wait(0.05)
        end
    end

    if dealButton then clickObject(dealButton) end
    task.wait(0.5)
end

-- ===== MAIN LOOP =====
while true do
    local lobbyBottom = waitForMainMenu()

    -- Click Traders
    local traders = lobbyBottom.main and lobbyBottom.main:FindFirstChild("traders")
    if traders then clickObject(traders) end
    task.wait(0.5)

    -- Select Dragov
    local traderList = PlayerGui.UI.HUD:FindFirstChild("traderListFrame")
    if traderList then
        local contents = traderList:FindFirstChild("contents")
        if contents then
            local dragov = contents:FindFirstChild("Dragov") or contents:FindFirstChildWhichIsA("TextButton")
            if dragov then clickObject(dragov) end
        end
    end
    task.wait(0.5)

    -- Dialogue loop
    local dialogueFrame = PlayerGui.UI.temp:FindFirstChild("dialogueFrame")
    while dialogueFrame do
        clickCenter()
        task.wait(0.1)

        local choice1 = dialogueFrame.main.dialogueChoices:FindFirstChild("1")
        if choice1 then clickObject(choice1) end

        dialogueFrame = PlayerGui.UI.temp:FindFirstChild("dialogueFrame")
    end

    -- Sell everything
    sellAll()

    -- Counters
    _G.relogCount = (_G.relogCount % 100) + 1
    _G.moneyEarned = _G.moneyEarned + 7446

    print("Relogs:", _G.relogCount)
    print("Money Earned:", _G.moneyEarned)

    -- Teleport (auto-restart)
    TeleportService:Teleport(game.PlaceId)
    task.wait(5)
end
